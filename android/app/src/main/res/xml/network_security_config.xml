<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local testing ke liye HTTP allow kar rahe hain -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Aapke server ka specific IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.88</domain>
    </domain-config>
</network-security-config>